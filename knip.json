{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "verify/**/*.mjs",
    "scripts/**/*.mjs",
    "src/debug/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "verify/**/*.mjs",
    "scripts/**/*.mjs"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": [
    "^/src/"
  ]
}
